// Top level = local (`wrangler dev`). Deploys must always pass --env staging or --env production.
// Staging D1 id is real; local and production ids are placeholders. IDs are not secrets.
// Secrets never go in this file: use `wrangler secret put` or .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-clinic-local",
  // Cloudflare account (not a secret). Top level, so staging and production inherit it.
  "account_id": "bc903cf48da626b1bbd501857a4a0013",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  // No version preview URLs: they would be a second address that Cloudflare Access does not guard.
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-clinic-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dental-clinic-local-files" }],
  "vars": { "MESSAGING_MODE": "dry_run" },
  "env": {
    "staging": {
      "name": "dental-clinic-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dental-clinic-staging",
          "database_id": "54a33625-2a34-4e8a-b736-4e65088a6faa",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      // No FILES (R2) binding on staging until task 3.7: R2 may need a card (see DECISIONS.md).
      "r2_buckets": [],
      "vars": { "MESSAGING_MODE": "dry_run" },
    },
    "production": {
      "name": "dental-clinic-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dental-clinic-production",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "dental-clinic-production-files" }],
      // Stays dry_run until Phase 7 sends real messages.
      "vars": { "MESSAGING_MODE": "dry_run" },
    },
  },
}
