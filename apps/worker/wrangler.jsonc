// Top level = local (`wrangler dev`). Deploys must always pass --env staging or --env production.
// Staging D1 id is real; local and production ids are placeholders. IDs are not secrets.
// Secrets never go in this file: use `wrangler secret put` or .dev.vars.
// Secrets per deployed env: GOOGLE_CLIENT_SECRET, AUTH_COOKIE_SECRET (docs/AUTH_PLAN.md 14).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-clinic-local",
  // Cloudflare account (not a secret). Top level, so staging and production inherit it.
  "account_id": "bc903cf48da626b1bbd501857a4a0013",
  // Local only: this entry adds the dev login stub. Staging/production set main to src/index.ts.
  "main": "src/dev/dev-entry.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  // No version preview URLs: they would be a second address that Cloudflare Access does not guard.
  "preview_urls": false,
  // Deploy version id/tag for /api/staff/health (1.6.2). Local/tests without it report "dev".
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-clinic-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dental-clinic-local-files" }],
  // One free-plan cron; branches live in src/cron/* (6.2.3 nightly stats, later messaging).
  "triggers": { "crons": ["*/5 * * * *"] },
  // ACCESS_*: empty = Cloudflare Access check off (1.3.1 waits on a card). Fill both to switch it on.
  // AUTH_MODE: "dev-stub" only here; staging and production must be "google" (dev-guard.test.ts).
  "vars": {
    "MESSAGING_MODE": "dry_run",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "APP_ORIGIN": "http://localhost:8787",
    "GOOGLE_CLIENT_ID": "",
    "AUTH_MODE": "dev-stub",
    // 3.7: local uses R2 binding FILES. Secrets S3_KEY_ID / S3_APP_KEY never in this file.
    "STORAGE_DRIVER": "local",
    "S3_ENDPOINT": "",
    "S3_BUCKET": "",
    "S3_REGION": "",
  },
  "env": {
    "staging": {
      "name": "dental-clinic-staging",
      "main": "src/index.ts",
      // Named envs do not inherit top-level version_metadata; health needs this (1.6.2).
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dental-clinic-staging",
          "database_id": "54a33625-2a34-4e8a-b736-4e65088a6faa",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      // Staging uses B2 via S3 API (STORAGE_DRIVER=s3). No R2 binding (card).
      "r2_buckets": [],
      "triggers": { "crons": ["*/5 * * * *"] },
      // S2.1.2: run the Worker near the D1 database (APAC) instead of at the visitor's edge.
      // Staging only, to measure; remove it if the logs show no gain.
      "placement": { "mode": "smart" },
      // GOOGLE_CLIENT_ID: the Google Cloud web client for staging + local (not a secret).
      // S3_* below are not secrets. Put S3_KEY_ID / S3_APP_KEY with `wrangler secret put` only.
      "vars": {
        "MESSAGING_MODE": "dry_run",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "APP_ORIGIN": "https://dental-clinic-staging.shubhamkks1005.workers.dev",
        "GOOGLE_CLIENT_ID": "310719770102-o5tts4nmp3715ltiobco5drd11phc9sh.apps.googleusercontent.com",
        "AUTH_MODE": "google",
        "STORAGE_DRIVER": "s3",
        "S3_ENDPOINT": "s3.us-east-005.backblazeb2.com",
        "S3_BUCKET": "align-dentistry-files-9076",
        "S3_REGION": "us-east-005",
      },
    },
    "production": {
      "name": "dental-clinic-production",
      "main": "src/index.ts",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dental-clinic-production",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      // Keep R2 binding as optional fallback; planned driver is B2 S3 (STORAGE_DRIVER=s3).
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "dental-clinic-production-files" }],
      "triggers": { "crons": ["*/5 * * * *"] },
      // Stays dry_run until Phase 7 sends real messages. APP_ORIGIN is set with the domain (8.1.3).
      "vars": {
        "MESSAGING_MODE": "dry_run",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "APP_ORIGIN": "",
        "GOOGLE_CLIENT_ID": "",
        "AUTH_MODE": "google",
        "STORAGE_DRIVER": "s3",
        "S3_ENDPOINT": "",
        "S3_BUCKET": "",
        "S3_REGION": "us-west-004",
      },
    },
  },
}
