{
  "name": "@clinic/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "wr": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler",
    "dev": "pnpm wr dev --env=''",
    "build": "pnpm wr deploy --dry-run --outdir dist --env=''",
    "types": "pnpm wr types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm wr d1 migrations apply DB --local --env=''",
    "deploy:staging": "pnpm wr deploy --env staging",
    "spike:d1": "node spike/run.mjs"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@clinic/db": "workspace:*",
    "@clinic/shared": "workspace:*",
    "hono": "^4.13.19"
  }
}
