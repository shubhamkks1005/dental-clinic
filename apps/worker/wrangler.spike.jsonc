// Spike 0.6.3 only. Runs on this Mac with `wrangler dev`, using the REAL throwaway D1 database
// "dental-clinic-spike" through a remote binding. Never deployed. Delete the database after the spike.
// database_id: replace the placeholder with the id printed by `wrangler d1 create dental-clinic-spike`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-clinic-spike",
  "main": "spike/d1-spike.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-clinic-spike",
      "database_id": "00000000-0000-0000-0000-000000000009",
      "migrations_dir": "../../packages/db/migrations",
      "remote": true,
    },
  ],
}
