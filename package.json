{
  "name": "dental-clinic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @clinic/web build && pnpm --parallel --filter @clinic/web --filter @clinic/worker dev",
    "build": "pnpm --filter @clinic/web build && pnpm --filter @clinic/worker build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test && vitest run scripts/backup/integrity.test.mjs scripts/billing-integrity/check.test.mjs",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @clinic/db db:generate",
    "db:lock": "pnpm --filter @clinic/db db:lock",
    "db:migrate": "pnpm --filter @clinic/worker db:migrate",
    "db:seed": "pnpm --filter @clinic/worker db:seed",
    "deploy:staging": "pnpm build && pnpm --filter @clinic/worker deploy:staging",
    "spike:d1": "pnpm --filter @clinic/worker spike:d1",
    "backup:dry-run": "BACKUP_DRY_RUN=1 bash scripts/backup/run.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
